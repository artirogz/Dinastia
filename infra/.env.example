# Copy to infra/.env on the server and to .env.local in the repository root for development.
# Never commit real values. Variable meaning: docs/03-auth-and-security.md section 9 and the docs named below.
# Generate secrets with:  openssl rand -hex 32

# ---- Server / compose (read by docker compose and Caddy) ----
# example.ru -> the app is served at app.example.ru
DOMAIN=
# certificate expiry notices
ACME_EMAIL=
# bind-mounted to /data/media (owner uid 1001, see docs/09)
MEDIA_HOST_DIR=/srv/courses/media

# ---- Postgres ----
POSTGRES_USER=courses
POSTGRES_PASSWORD=
POSTGRES_DB=courses
# In production the host is the compose service name, in development it is localhost.
# Production: postgres://<POSTGRES_USER>:<POSTGRES_PASSWORD>@postgres:5432/<POSTGRES_DB>
# Development: postgres://courses:courses@localhost:5432/courses
DATABASE_URL=

# ---- Telegram (docs/03, docs/06) ----
BOT_TOKEN=
# without @, used in deep links
BOT_USERNAME=
# random string, sent by Telegram in X-Telegram-Bot-Api-Secret-Token
TG_WEBHOOK_SECRET=
# comma-separated Telegram ids of administrators
ADMIN_TG_IDS=

# ---- Sessions (docs/03) ----
# at least 32 bytes
SESSION_SECRET=
SESSION_INIT_DATA_TTL_SEC=300
# 1 only in .env.local; the dev login route does not exist in production builds
DEV_LOGIN=0

# ---- YooKassa (docs/04) ----
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# https://t.me/<bot>?start=paid_  (order id is appended)
YOOKASSA_RETURN_URL=
# depends on the seller tax regime, ask the accountant
YOOKASSA_VAT_CODE=

# ---- Video (docs/05) ----
# kinescope | hls
VIDEO_PROVIDER=kinescope
KINESCOPE_API_KEY=
KINESCOPE_PROJECT_ID=
# signs the short-lived token the player passes back to /api/video/authorize
KINESCOPE_AUTH_SECRET=
HLS_SIGNING_SECRET=

# ---- Files (docs/01, docs/05) ----
# locally ./data/media, on the server /data/media (the container volume, see MEDIA_HOST_DIR)
MEDIA_ROOT=/data/media
MEDIA_SIGNING_SECRET=

# ---- Public URLs and legal texts (docs/03, docs/06) ----
# https://app.<DOMAIN>
PUBLIC_APP_URL=
# personal data processing policy
POLICY_URL=
# public offer for the courses
OFFER_URL=
# bump when the policy text changes; stored in users.consent_version
CONSENT_VERSION=1

# ---- Logging ----
LOG_LEVEL=info

# ---- Backups (read by infra/backup.sh, not by the app) ----
BACKUP_DIR=/srv/courses/backups
BACKUP_RETENTION_DAYS=14
# e.g. ru-s3:courses-backups  (remote created with `rclone config`)
BACKUP_RCLONE_REMOTE=
# optional: push URL of an Uptime Kuma "push" monitor, pinged on success
BACKUP_HEARTBEAT_URL=
